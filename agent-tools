#!/usr/bin/env node
// Command-line client for the container's tools API (see AGENTS.MD).
//   agent-tools notify "Backup finished" [--title "Nightly job"]
//   agent-tools email "Subject" "Body text" [--html body.html] [--to a@example.com]
//                                 body "-" reads the text from stdin
//   agent-tools config            list keys in agent.env
//   agent-tools config KEY        print one value
//   agent-tools logs [NAME] [--lines N]   list logs, or print the end of one ('agent' or a job)
//   agent-tools api               list every endpoint (GET /openapi.json has the details)
//   agent-tools <operation> key=value ...   call any endpoint by its operationId, e.g.
//     agent-tools add_schedule name=news cron="0 7 * * *" command=./run.sh cwd=/workspace/myNewsFeed
//     agent-tools run_schedule name=news
const base = process.env.AGENT_TOOLS_URL || "http://127.0.0.1:7777";
const [cmd, ...args] = process.argv.slice(2);

async function call(method, path, body) {
  const res = await fetch(`${base}${path}`, {
    method,
    headers: body ? { "content-type": "application/json" } : undefined,
    body: body ? JSON.stringify(body) : undefined,
  });
  const data = await res.json();
  if (!data.ok) {
    console.error(`agent-tools: ${data.error}`);
    process.exit(1);
  }
  return data;
}

try {
  if (cmd === "notify" && args.length) {
    const i = args.indexOf("--title");
    const title = i >= 0 ? args.splice(i, 2)[1] : undefined;
    await call("POST", "/notify", { text: args.join(" "), title });
  } else if (cmd === "email") {
    const opt = (name) => {
      const i = args.indexOf(name);
      return i >= 0 ? args.splice(i, 2)[1] : undefined;
    };
    const htmlFile = opt("--html");
    const to = opt("--to");
    const [subject, body] = args;
    if (!subject || body === undefined || args.length > 2) {
      console.error('Usage: agent-tools email "Subject" "Body text" [--html body.html] [--to a@example.com]');
      process.exit(2);
    }
    const { readFileSync } = await import("node:fs");
    const text = body === "-" ? readFileSync(0, "utf8") : body;
    const html = htmlFile ? readFileSync(htmlFile, "utf8") : undefined;
    const data = await call("POST", "/email", { subject, text, html, to });
    console.log(`Sent to ${data.to.join(", ")}`);
  } else if (cmd === "config" && args.length <= 1) {
    const data = await call("GET", args[0] ? `/config/${encodeURIComponent(args[0])}` : "/config");
    console.log(args[0] ? data.value : data.keys.join("\n"));
  } else if (cmd === "logs" && args.length <= 3) {
    const i = args.indexOf("--lines");
    const lines = i >= 0 ? args.splice(i, 2)[1] : undefined;
    if (args[0]) {
      const query = lines ? `?lines=${encodeURIComponent(lines)}` : "";
      console.log((await call("GET", `/logs/${encodeURIComponent(args[0])}${query}`)).text);
    } else {
      for (const l of (await call("GET", "/logs")).logs) console.log(`${l.name.padEnd(42)}${String(l.bytes).padStart(9)} bytes  ${l.modified}`);
    }
  } else if (cmd === "api" && !args.length) {
    const { endpoints } = await call("GET", "/");
    for (const e of endpoints) console.log(`${e.method.padEnd(7)}${e.path.padEnd(24)}${e.summary}`);
  } else if (cmd && /^[a-z_]+$/.test(cmd) && args.every((a) => a.includes("="))) {
    // Any endpoint by operationId, so every API feature has a command without extra code here.
    const spec = await (await fetch(`${base}/openapi.json`)).json();
    const found = Object.entries(spec?.paths ?? {}).flatMap(([path, ops]) =>
      Object.entries(ops).map(([method, op]) => ({ path, method: method.toUpperCase(), op })))
      .find((e) => e.op.operationId === cmd);
    if (!found) {
      console.error(`agent-tools: no endpoint called ${cmd}. Run agent-tools api to see them.`);
      process.exit(2);
    }
    const input = Object.fromEntries(args.map((a) => [a.slice(0, a.indexOf("=")), a.slice(a.indexOf("=") + 1)]));
    const params = found.op.parameters ?? [];
    let path = found.path;
    const query = new URLSearchParams();
    for (const p of params) {
      if (!(p.name in input)) continue;
      if (p.in === "path") path = path.replace(`{${p.name}}`, encodeURIComponent(input[p.name]));
      else query.set(p.name, input[p.name]);
      delete input[p.name];
    }
    const bodySchema = found.op.requestBody?.content?.["application/json"]?.schema?.properties ?? {};
    for (const [k, v] of Object.entries(input)) if (bodySchema[k]?.type === "integer") input[k] = Number(v);
    const qs = query.size ? `?${query}` : "";
    const data = await call(found.method, path + qs, found.method === "POST" ? input : undefined);
    delete data.ok;
    console.log(typeof data.text === "string" ? data.text : JSON.stringify(data, null, 2));
  } else {
    console.error('Usage: agent-tools notify "text" [--title "title"] | email "Subject" "Body" [--html file] [--to addr] | config [KEY] | logs [NAME] [--lines N] | api | <operation> key=value ...');
    process.exit(2);
  }
} catch (e) {
  console.error(`agent-tools: can't reach the tools API at ${base} (${e.cause?.code ?? e.message})`);
  process.exit(1);
}
