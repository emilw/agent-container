# Agent container config. On the NAS this is ./config/agent.env (mounted at /config).
# Created from this template on first start. Never commit the filled-in file.

# Telegram bot token from @BotFather. Use a bot only this container uses:
# two programs can't read the same bot's messages at once.
TELEGRAM_TOKEN=

# Comma-separated Telegram user IDs allowed to use the bot (get yours from @userinfobot).
# Each user must send /start to the bot once before it can message them.
ALLOWED_USER_IDS=

# Name for this machine in claude.ai/code and the Claude apps
RC_NAME=nas

# Extra flags for `claude remote-control`, e.g. --spawn worktree --permission-mode acceptEdits
RC_ARGS=

# How often to check the login, in minutes
CHECK_INTERVAL_MINUTES=30

# Every N hours, send a tiny prompt (Haiku) to check the login actually works.
# This is what catches an expired login. Uses a very small amount of your plan's usage.
# 0 turns it off.
HEALTH_PING_HOURS=6

# Port for the tools API (localhost only, see AGENTS.MD)
TOOLS_PORT=7777

# Container name used in log messages
CONTAINER_NAME=claude

# ---------- Git and GitHub ----------
# The GitHub CLI (gh) is installed and git pushes through it. Either ask Claude to
# "log in to GitHub" (you approve a one-time code at github.com/login/device, and the
# login is saved in config/gh), or set a token here. Prefer a fine-grained token
# limited to the repos Claude should touch. Needs a restart.
# GH_TOKEN=

# Name and email on the commits Claude makes. Needs a restart.
# GIT_AUTHOR_NAME=Your Name
# GIT_AUTHOR_EMAIL=you@example.com
# GIT_COMMITTER_NAME=Your Name
# GIT_COMMITTER_EMAIL=you@example.com

# ---------- Email ----------
# For POST /email, the email MCP tool and `agent-tools email`. Read on every send, so
# no restart is needed. Same names as myNewsFeed's .env. Port 587 uses STARTTLS, 465 TLS.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=sender@example.com
# SMTP_PASS=
# MAIL_FROM=Agent <sender@example.com>
# MAIL_TO=you@example.com
# Other addresses programs may send to (comma-separated). Mail never goes anywhere else.
# MAIL_ALLOWED_TO=

# ---------- Your own values ----------
# Programs in /workspace read everything in this file through the tools API
# (GET $AGENT_TOOLS_URL/config/<KEY> or `agent-tools config KEY`), except TELEGRAM_TOKEN,
# GH_TOKEN and SMTP_PASS.
# Changes are picked up immediately; only the container settings above need a restart.
# Anything in the container, including Claude, can read these values.

# EXAMPLE_API_URL=https://example.com/api
