# Agent container config. On the NAS this is ./config/agent.env (mounted at /config).
# Created from this template on first start. Never commit the filled-in file.

# Telegram bot token from @BotFather
TELEGRAM_TOKEN=

# Comma-separated Telegram user IDs to notify (get yours from @userinfobot).
# Each user must send /start to the bot once before it can message them.
ALLOWED_USER_IDS=

# Name for this machine in claude.ai/code and the Claude apps
RC_NAME=nas

# Extra flags for `claude remote-control`, e.g. --spawn worktree --permission-mode acceptEdits
RC_ARGS=

# How often to check the login, in minutes
CHECK_INTERVAL_MINUTES=30

# 1 = once a day, send a tiny prompt (Haiku) to check the login actually works.
# This is what catches an expired login. Uses a very small amount of your plan's usage.
HEALTH_PING=1

# Container name used in the instructions sent to Telegram
CONTAINER_NAME=claude
